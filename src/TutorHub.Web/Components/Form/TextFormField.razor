<div>
    <label for="@id" class="text-heading mb-1 block text-sm font-medium">@label</label>
    <input type="@type" id="@id" value="@Value" @oninput="@handleInputChange"
           class="border-default-medium text-heading rounded-base shadow-xs block w-full border bg-gray-200 px-3 py-2.5 text-sm placeholder:text-body focus:ring-brand focus:border-brand"
           placeholder="@placeholder" />

</div>

@code {
    [Parameter]
    public string id { get; set; } = string.Empty;
    [Parameter]
    public string Value { get; set; } = string.Empty;
    [Parameter]
    public string placeholder { get; set; } = string.Empty;
    [Parameter]
    public string label { get; set; } = string.Empty;
    [Parameter]
    public string? type { get; set; } = "text";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }
    
    private async Task handleInputChange(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}
