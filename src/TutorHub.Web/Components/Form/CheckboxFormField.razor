<div class="flex items-center">
    <input id="@id" type="checkbox" @bind="isChecked" class="w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft">
    <label for="@id" class="select-none ms-2 text-sm font-medium text-heading">@text</label>
</div>

@code {
    [Parameter]
    public string id { get; set; } = string.Empty;
    [Parameter]
    public string text { get; set; } = string.Empty;
    [Parameter]
    public bool? isChecked { get; set; } = false;
    
}
